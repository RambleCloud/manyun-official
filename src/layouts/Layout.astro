
---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '漫云科技工作室 | 软件开发与数字化服务',
  description = '漫云科技工作室，专注于软件与系统开发、学术科研指导及知识产权相关服务。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- 网站图标 -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href="https://manyun-official.pages.dev/" />
    <!-- Open Graph 社交分享信息 -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="漫云科技工作室" />
    <meta property="og:url" content="https://manyun-official.pages.dev/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- Twitter / X 分享信息 -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-white text-slate-900 antialiased">
    <slot />
  </body>
</html>
